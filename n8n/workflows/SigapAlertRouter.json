{
  "name": "SIGAP · alert router",
  "id": "SigapAlertRouter",
  "nodes": [
    {
      "id": "fc00eb6c-04ab-4893-8ce3-3a837c32fcc3",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "74c26025-5a4f-4634-b7ef-c8a497c15cb5",
      "name": "Get open alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "url": "={{ $env.SIGAP_API_URL }}/v1/ops/alerts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "notes": "Header Auth credential 'SIGAP ops key': name X-API-Key, value = SIGAP_OPS_API_KEY from .env"
    },
    {
      "id": "bdcdceae-b890-4b09-9db8-a70797dec4ae",
      "name": "Channel",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c4bd67af-f366-449a-9211-c6de25360851",
              "leftValue": "={{ $env.SIGAP_ALERT_CHANNEL }}",
              "rightValue": "whatsapp",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "notes": "SIGAP_ALERT_CHANNEL in .env: whatsapp -> true branch, anything else (default email) -> false branch."
    },
    {
      "id": "d153e93c-4dc2-4739-a749-700829b9095d",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        720,
        -140
      ],
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $env.SIGAP_WA_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $env.SIGAP_ANALYST_WHATSAPP }}",
        "textBody": "={{ $json.message }}",
        "additionalFields": {}
      },
      "notes": "WhatsApp Cloud API credential. Free-form text needs an open 24-hour window: message the business number first."
    },
    {
      "id": "0a1d18aa-048f-484b-adfe-5e3ef9cc347f",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        720,
        140
      ],
      "parameters": {
        "fromEmail": "={{ $env.SIGAP_ANALYST_EMAIL }}",
        "toEmail": "={{ $env.SIGAP_ANALYST_EMAIL }}",
        "subject": "=[SIGAP] {{ $json.kind }} · {{ $json.severity }}",
        "emailFormat": "text",
        "text": "={{ $json.message }}",
        "options": {
          "appendAttribution": false
        }
      },
      "notes": "SMTP credential 'SIGAP Gmail SMTP' (smtp.gmail.com, port 465, SSL, Gmail app password)."
    },
    {
      "id": "8463c854-eb98-4235-8395-c2dd4c9cf961",
      "name": "Acknowledge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SIGAP_API_URL }}/v1/ops/alerts/{{ $('Get open alerts').item.json.alert_key }}/ack",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $env.SIGAP_ALERT_CHANNEL === 'whatsapp' ? 'whatsapp' : 'email' }) }}",
        "options": {}
      },
      "notes": "Runs only after the channel node succeeded, so a failed send stays open and is retried. WhatsApp success means Meta accepted the message, not that it was delivered (ADR 0007)."
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Get open alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get open alerts": {
      "main": [
        [
          {
            "node": "Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Channel": {
      "main": [
        [
          {
            "node": "Send WhatsApp",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp": {
      "main": [
        [
          {
            "node": "Acknowledge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send email": {
      "main": [
        [
          {
            "node": "Acknowledge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jakarta"
  },
  "active": false,
  "pinData": {}
}
