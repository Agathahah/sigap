# Copy to .env (git-ignored) and change the passwords.
POSTGRES_USER=sigap
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sigap
SIGAP_DB_URL=postgresql+psycopg://sigap:change-me@localhost:5433/sigap
SIGAP_API_KEY=change-me-too
SIGAP_VARIANT=Base
SIGAP_LABEL_LAG=2
# Phase 9
ANTHROPIC_API_KEY=
SIGAP_LLM_MODEL=anthropic:claude-haiku-5-5
SIGAP_COPILOT_PROMPT=v2
SIGAP_COPILOT_ROUTER=off
SIGAP_COPILOT_DB_PASSWORD=change-me-copilot
OLLAMA_NUM_CTX=8192
SIGAP_COPILOT_MAX_STEPS=8
SIGAP_COPILOT_DAILY_BUDGET_USD=0.30
# Phase 8b · ops automation (n8n + WhatsApp). Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SIGAP_OPS_API_KEY=change-me-ops
SIGAP_RUNBOOK_URL=https://github.com/Agathahah/sigap/blob/main/docs/RUNBOOK.md
N8N_ENCRYPTION_KEY=change-me-n8n
N8N_WEBHOOK_URL=http://localhost:5678/
SIGAP_API_URL_FOR_N8N=http://host.docker.internal:8000
SIGAP_ANALYST_WHATSAPP=
SIGAP_WA_PHONE_NUMBER_ID=
# whatsapp needs a business number in the recipient's country (Meta error 130497); email works everywhere
SIGAP_ALERT_CHANNEL=email
SIGAP_ANALYST_EMAIL=
# Phase 11 · Telegram bot (token from @BotFather; chat ids: send /start to the bot, it replies with yours)
SIGAP_TELEGRAM_BOT_TOKEN=
SIGAP_TELEGRAM_CHAT_IDS=
SIGAP_API_URL_FOR_BOT=http://127.0.0.1:8000
